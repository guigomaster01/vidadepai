---
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md transition-all duration-200">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16">
			<!-- Logo / Brand -->
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2.5 text-decoration-none group">
					<span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-amber-500 flex items-center justify-center text-white font-extrabold text-xl shadow-md group-hover:scale-105 transition-transform duration-200">
						VP
					</span>
					<div class="flex flex-col">
						<span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-blue-700 transition-colors">
							Vida de Pai
						</span>
						<span class="text-[10px] uppercase font-semibold tracking-wider text-slate-500 -mt-1">
							Paternidade Real
						</span>
					</div>
				</a>
			</div>

			<!-- Desktop Navigation -->
			<nav class="hidden md:flex items-center gap-1 font-medium text-sm text-slate-700">
				<HeaderLink href="/" class="px-3 py-2 rounded-lg hover:text-blue-700 hover:bg-slate-100 transition-colors">
					Início
				</HeaderLink>
				<HeaderLink href="/blog" class="px-3 py-2 rounded-lg hover:text-blue-700 hover:bg-slate-100 transition-colors">
					Artigos
				</HeaderLink>
				<HeaderLink href="/ferramentas" class="px-3 py-2 rounded-lg hover:text-blue-700 hover:bg-slate-100 transition-colors flex items-center gap-1.5">
					<span>Ferramentas</span>
					<span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300">
						Subdomínio
					</span>
				</HeaderLink>
				<HeaderLink href="/sobre" class="px-3 py-2 rounded-lg hover:text-blue-700 hover:bg-slate-100 transition-colors">
					Sobre
				</HeaderLink>
				<HeaderLink href="/contato" class="px-3 py-2 rounded-lg hover:text-blue-700 hover:bg-slate-100 transition-colors">
					Contato
				</HeaderLink>
			</nav>

			<!-- Right Action / Search / Social -->
			<div class="flex items-center gap-3">
				<a
					href="/blog"
					class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow transition-all duration-200"
				>
					Explorar Posts
				</a>

				<!-- Mobile Menu Button -->
				<button
					id="mobile-menu-btn"
					type="button"
					aria-label="Abrir menu"
					class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
				>
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Dropdown -->
		<div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-slate-100">
			<div class="flex flex-col space-y-1 font-medium text-sm">
				<a href="/" class="px-3 py-2 rounded-md text-slate-700 hover:bg-slate-100">Início</a>
				<a href="/blog" class="px-3 py-2 rounded-md text-slate-700 hover:bg-slate-100">Artigos</a>
				<a href="/ferramentas" class="px-3 py-2 rounded-md text-slate-700 hover:bg-slate-100 flex items-center justify-between">
					<span>Ferramentas</span>
					<span class="text-[10px] px-2 py-0.5 rounded bg-amber-100 text-amber-800">Subdomínio</span>
				</a>
				<a href="/sobre" class="px-3 py-2 rounded-md text-slate-700 hover:bg-slate-100">Sobre</a>
				<a href="/contato" class="px-3 py-2 rounded-md text-slate-700 hover:bg-slate-100">Contato</a>
			</div>
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	if (menuBtn && mobileMenu) {
		menuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});
	}
</script>

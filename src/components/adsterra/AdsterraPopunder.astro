---
import { ADSTERRA_ENABLED, ADSTERRA_POPUNDER_SCRIPT } from './constants';

interface Props {
	enabled?: boolean;
	showInDev?: boolean;
}

const {
	enabled = ADSTERRA_ENABLED,
	showInDev = false,
} = Astro.props;

const isProduction = !import.meta.env.DEV || showInDev;
const shouldRender = enabled && isProduction;
---

{shouldRender && (
	<script
		is:inline
		data-cfasync="false"
		src={ADSTERRA_POPUNDER_SCRIPT}
	></script>
)}

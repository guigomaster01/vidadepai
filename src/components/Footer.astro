---
import { CATEGORIES } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-20 border-t border-slate-800">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10">
			<!-- Coluna 1: Sobre Vida de Pai -->
			<div class="md:col-span-1">
				<div class="flex items-center gap-2.5 mb-4">
					<span class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-500 to-amber-500 flex items-center justify-center text-white font-extrabold text-lg shadow-sm">
						VP
					</span>
					<span class="text-xl font-bold tracking-tight text-white">
						Vida de Pai
					</span>
				</div>
				<p class="text-xs text-slate-400 leading-relaxed mb-4">
					Conteúdo confiável sobre paternidade real, dicas práticas, educação positiva, finanças e o dia a dia com os filhos.
				</p>
				<div class="text-xs text-slate-400 flex items-center gap-1.5">
					<span class="w-2 h-2 rounded-full bg-emerald-400"></span>
					<span>vidadepai.com.br</span>
				</div>
			</div>

			<!-- Coluna 2: Navegação Rápida -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">
					Navegação
				</h3>
				<ul class="space-y-2 text-xs text-slate-400">
					<li><a href="/" class="hover:text-white transition-colors">Início</a></li>
					<li><a href="/blog" class="hover:text-white transition-colors">Todos os Artigos</a></li>
					<li><a href="/ferramentas" class="hover:text-white transition-colors flex items-center gap-1.5">
						<span>Ferramentas & Calculadoras</span>
						<span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-400/20 text-amber-300">Subdomínios</span>
					</a></li>
					<li><a href="/sobre" class="hover:text-white transition-colors">Sobre Nós</a></li>
					<li><a href="/contato" class="hover:text-white transition-colors">Fale Conosco</a></li>
				</ul>
			</div>

			<!-- Coluna 3: Categorias -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">
					Categorias
				</h3>
				<ul class="space-y-2 text-xs text-slate-400">
					{CATEGORIES.map((cat) => (
						<li>
							<a href="/blog" class="hover:text-white transition-colors">
								{cat.name}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Coluna 4: Legal & Monetização (Exigido pelo AdSense) -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-3">
					Transparência & Legal
				</h3>
				<p class="text-[11px] text-slate-400 leading-normal mb-3">
					Este site exibe anúncios através do programa Google AdSense e utiliza cookies para personalizar conteúdo.
				</p>
				<ul class="space-y-2 text-xs text-slate-400">
					<li>
						<a href="/politica-de-privacidade" class="text-slate-300 hover:text-white underline underline-offset-2 transition-colors">
							Política de Privacidade (LGPD)
						</a>
					</li>
					<li>
						<a href="/termos-de-uso" class="text-slate-300 hover:text-white underline underline-offset-2 transition-colors">
							Termos de Uso
						</a>
					</li>
					<li>
						<a href="/contato" class="hover:text-white transition-colors">
							Anuncie / Parcerias
						</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Linha Inferior -->
		<div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
			<p>© {currentYear} Vida de Pai (vidadepai.com.br). Todos os direitos reservados.</p>
			<div class="flex items-center gap-4 text-xs">
				<span class="inline-flex items-center gap-1.5 text-slate-400">
					<svg class="w-3.5 h-3.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
					</svg>
					Cloudflare Edge Network
				</span>
				<span>•</span>
				<span>Astro + Tailwind</span>
			</div>
		</div>
	</div>
</footer>

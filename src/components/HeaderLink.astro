---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const cleanPath = pathname.replace(/\/$/, '') || '/';
const cleanHref = typeof href === 'string' ? href.replace(/\/$/, '') || '/' : href;
const isActive = cleanHref === cleanPath || (cleanHref !== '/' && cleanPath.startsWith(String(cleanHref)));
---

<a
	href={href}
	class:list={[
		className,
		isActive
			? 'text-blue-700 font-semibold bg-blue-50/80 shadow-xs'
			: 'text-slate-600 hover:text-blue-700 hover:bg-slate-100/80',
	]}
	{...props}
>
	<slot />
</a>

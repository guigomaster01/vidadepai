---
import { ADSENSE_CLIENT_ID } from '../consts';

interface Props {
	slotId?: string;
	slotName?: string;
	format?: 'auto' | 'rectangle' | 'horizontal' | 'vertical' | 'fluid';
	responsive?: boolean;
	className?: string;
	minHeight?: string;
}

const {
	slotId = '0000000000',
	slotName = 'Espaço Publicitário',
	format = 'auto',
	responsive = true,
	className = '',
	minHeight = '120px',
} = Astro.props;

// Verifica se o ID do AdSense é um ID real de produção
const isConfigured = ADSENSE_CLIENT_ID && !ADSENSE_CLIENT_ID.includes('XXXX') && !import.meta.env.DEV;
---

<div class={`adsense-wrapper my-6 overflow-hidden ${className}`}>
	<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1 text-center">
		Publicidade
	</div>

	{isConfigured ? (
		<div class="adsense-real flex justify-center items-center w-full" style={`min-height: ${minHeight};`}>
			<ins
				class="adsbygoogle"
				style="display:block; text-align:center; width:100%;"
				data-ad-client={ADSENSE_CLIENT_ID}
				data-ad-slot={slotId}
				data-ad-format={format}
				data-full-width-responsive={responsive ? 'true' : 'false'}
			></ins>
			<script is:inline>
				(adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		</div>
	) : (
		<div
			class="adsense-placeholder border-2 border-dashed border-slate-300 bg-slate-50/80 rounded-xl p-4 flex flex-col items-center justify-center text-center transition-all duration-200 hover:border-amber-400/60"
			style={`min-height: ${minHeight};`}
		>
			<div class="flex items-center gap-2 mb-1.5">
				<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-500/10 text-amber-600 text-xs font-bold">
					$
				</span>
				<span class="text-xs font-semibold text-slate-700">
					Google AdSense ({slotName})
				</span>
			</div>
			<p class="text-xs text-slate-500 max-w-md">
				Slot ID: <code class="px-1.5 py-0.5 rounded bg-slate-200/60 text-[11px] font-mono">{slotId}</code> • Formato: <span class="capitalize">{format}</span>
			</p>
			<span class="mt-2 text-[10px] text-amber-600 font-medium px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200">
				Pronto para monetização no Cloudflare
			</span>
		</div>
	)}
</div>

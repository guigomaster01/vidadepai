---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead
			title={`Contato & Parcerias | ${SITE_TITLE}`}
			description="Fale com a equipe do Vida de Pai. Envie sugestões, dúvidas, feedbacks ou propostas comerciais e de publicidade."
		/>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between">
		<Header />

		<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Informações Laterais -->
				<div class="md:col-span-1 space-y-6">
					<div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs">
						<span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full">
							Fale Conosco
						</span>
						<h1 class="text-2xl font-extrabold text-slate-900 mt-3 mb-2">
							Contato
						</h1>
						<p class="text-xs text-slate-500 leading-relaxed mb-6">
							Estamos sempre abertos a sugestões de temas, dúvidas sobre paternidade e propostas de parcerias comerciais.
						</p>

						<div class="space-y-4 text-xs">
							<div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80">
								<span class="block font-semibold text-slate-700 mb-0.5">E-mail Editorial & Dúvidas</span>
								<a href={`mailto:${CONTACT_EMAIL}`} class="text-blue-600 font-medium break-all hover:underline">
									{CONTACT_EMAIL}
								</a>
							</div>

							<div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80">
								<span class="block font-semibold text-slate-700 mb-0.5">Parcerias & Mídia Kit</span>
								<span class="text-slate-600">
									Para anúncios diretos, publieditoriais ou parcerias institucionais.
								</span>
							</div>

							<div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80">
								<span class="block font-semibold text-slate-700 mb-0.5">Tempo de Resposta</span>
								<span class="text-slate-600">
									Respondemos normalmente em até 24 a 48 horas úteis.
								</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Formulário de Mensagem -->
				<div class="md:col-span-2">
					<div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs">
						<h2 class="text-xl font-bold text-slate-900 mb-1">Envie sua Mensagem</h2>
						<p class="text-xs text-slate-500 mb-6">
							Preencha os campos abaixo e entraremos em contato com você o mais breve possível.
						</p>

						<form id="contact-form" class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('success-alert').classList.remove('hidden'); this.reset();">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="name" class="block text-xs font-semibold text-slate-700 mb-1">Seu Nome *</label>
									<input
										type="text"
										id="name"
										required
										placeholder="Ex: Carlos Silva"
										class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600/30 focus:border-blue-600"
									/>
								</div>

								<div>
									<label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Seu E-mail *</label>
									<input
										type="email"
										id="email"
										required
										placeholder="Ex: carlos@email.com"
										class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600/30 focus:border-blue-600"
									/>
								</div>
							</div>

							<div>
								<label for="subject" class="block text-xs font-semibold text-slate-700 mb-1">Assunto</label>
								<select
									id="subject"
									class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600/30 focus:border-blue-600 bg-white"
								>
									<option value="duvida">Dúvida ou sugestão de artigo</option>
									<option value="ferramenta">Ideia para nova ferramenta / calculadora</option>
									<option value="parceria">Publicidade / Parceria comercial</option>
									<option value="outro">Outro assunto</option>
								</select>
							</div>

							<div>
								<label for="message" class="block text-xs font-semibold text-slate-700 mb-1">Sua Mensagem *</label>
								<textarea
									id="message"
									rows="5"
									required
									placeholder="Escreva sua mensagem aqui com detalhes..."
									class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600/30 focus:border-blue-600"
								></textarea>
							</div>

							<div id="success-alert" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs">
								✅ Mensagem registrada com sucesso! Agradecemos o contato e retornaremos em breve.
							</div>

							<button
								type="submit"
								class="w-full sm:w-auto px-6 py-2.5 bg-blue-600 hover:bg-blue-700 !text-white font-semibold rounded-lg text-sm shadow-sm transition-colors duration-200 cursor-pointer"
							>
								Enviar Mensagem
							</button>
						</form>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

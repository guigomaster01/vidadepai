---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { AdsterraResponsiveBanner } from '../../components/adsterra';
import { SITE_TITLE, SITE_URL, CATEGORIES } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const breadcrumbs = [
	{ name: 'Início', url: '/' },
	{ name: 'Artigos e Guias', url: '/blog' },
];

const blogCollectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Artigos e Guias sobre Paternidade | ${SITE_TITLE}`,
	description:
		'Navegue por todos os artigos do Vida de Pai: sono do bebê, primeiros meses, licença-paternidade, educação positiva, saúde da família e finanças.',
	url: `${SITE_URL}/blog`,
	inLanguage: 'pt-BR',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, idx) => ({
			'@type': 'ListItem',
			position: idx + 1,
			url: `${SITE_URL}/blog/${post.id}/`,
			name: post.data.title,
		})),
	},
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead
			title={`Artigos e Guias sobre Paternidade | ${SITE_TITLE}`}
			description="Navegue por todos os artigos do Vida de Pai: sono do bebê, primeiros meses, nova licença-paternidade, educação positiva, saúde e finanças familiares."
			breadcrumbs={breadcrumbs}
			schema={blogCollectionSchema}
		/>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between">
		<Header />

		<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 flex-1 w-full">
			<!-- Breadcrumbs Semânticos -->
			<nav aria-label="Breadcrumb" class="mb-6">
				<ol class="flex items-center gap-2 text-xs text-slate-500 justify-center">
					<li>
						<a href="/" class="hover:text-blue-600 transition-colors">Início</a>
					</li>
					<li aria-hidden="true">/</li>
					<li class="text-slate-700 font-medium">Artigos e Guias</li>
				</ol>
			</nav>

			<!-- Header da Página -->
			<div class="mb-10 text-center max-w-2xl mx-auto">
				<span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
					Conteúdo Prático
				</span>
				<h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mt-3 tracking-tight">
					Artigos & Guias sobre Paternidade
				</h1>
				<p class="text-sm sm:text-base text-slate-600 mt-3">
					Experiências reais, dicas comprovadas e orientações para apoiar você em cada fase da criação dos seus filhos.
				</p>
			</div>

			<!-- Barra de Categorias Interativa -->
			<div class="flex flex-wrap items-center justify-center gap-2 mb-10 pb-6 border-b border-slate-200" role="tablist" aria-label="Filtrar artigos por categoria">
				<button
					type="button"
					data-category-filter="all"
					class="category-btn text-xs px-3.5 py-1.5 rounded-full bg-blue-600 text-white border border-blue-600 transition-colors font-semibold cursor-pointer"
				>
					Todos ({posts.length})
				</button>
				{CATEGORIES.map((cat) => (
					<a
						href={`#${cat.slug}`}
						data-category-filter={cat.name}
						data-category-slug={cat.slug}
						class="category-btn text-xs px-3.5 py-1.5 rounded-full bg-white text-slate-700 border border-slate-200 hover:border-blue-500 hover:text-blue-700 transition-colors font-medium cursor-pointer"
					>
						{cat.name}
					</a>
				))}
			</div>

			<!-- Adsterra Anúncio 1: Topo Responsivo (728x90 no Desktop / 320x50 no Mobile) -->
			<AdsterraResponsiveBanner desktopSize="728x90" mobileSize="320x50" />

			<!-- Post Destaque Principal -->
			{featuredPost && (
				<section id="featured-post-section" data-post-category={featuredPost.data.category} class="my-10 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm hover:border-blue-400 transition-all duration-300">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
						<div class="lg:col-span-7 overflow-hidden rounded-2xl">
							<a href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.heroImage && (
									<Image
										width={800}
										height={450}
										src={featuredPost.data.heroImage}
										alt={featuredPost.data.title}
										loading="eager"
										fetchpriority="high"
										class="w-full h-auto max-h-[380px] object-cover hover:scale-102 transition-transform duration-300"
									/>
								)}
							</a>
						</div>

						<div class="lg:col-span-5 space-y-4">
							<div class="flex items-center gap-2">
								<span class="text-[11px] font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
									Destaque
								</span>
								<span class="text-xs font-bold uppercase tracking-wider text-blue-700">
									{featuredPost.data.category}
								</span>
							</div>

							<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
								<a href={`/blog/${featuredPost.id}/`} class="hover:text-blue-700 transition-colors">
									{featuredPost.data.title}
								</a>
							</h2>

							<p class="text-sm text-slate-600 leading-relaxed">
								{featuredPost.data.description}
							</p>

							<div class="pt-2 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100">
								<span>{featuredPost.data.readTime}</span>
								<FormattedDate date={featuredPost.data.pubDate} />
							</div>

							<a
								href={`/blog/${featuredPost.id}/`}
								class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:text-blue-800 transition-colors"
							>
								Ler artigo completo →
							</a>
						</div>
					</div>
				</section>
			)}


			<!-- Grid dos Demais Posts -->
			<section class="my-10">
				<h2 id="posts-grid-heading" class="text-xl font-bold text-slate-900 mb-6">Todos os Artigos Recentes</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
					{remainingPosts.map((post) => (
						<article data-post-category={post.data.category} class="blog-card bg-white rounded-2xl border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all duration-200 flex flex-col justify-between overflow-hidden">
							<div>
								<a href={`/blog/${post.id}/`} class="block overflow-hidden">
									{post.data.heroImage && (
										<Image
											width={600}
											height={340}
											src={post.data.heroImage}
											alt={post.data.title}
											class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
										/>
									)}
								</a>
								<div class="p-6">
									<div class="flex items-center justify-between gap-2 mb-2.5">
										<span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full">
											{post.data.category}
										</span>
										<span class="text-[11px] text-slate-400">
											{post.data.readTime}
										</span>
									</div>

									<h3 class="text-lg font-bold text-slate-900 leading-snug mb-2">
										<a href={`/blog/${post.id}/`} class="hover:text-blue-700 transition-colors">
											{post.data.title}
										</a>
									</h3>

									<p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
										{post.data.description}
									</p>
								</div>
							</div>

							<div class="px-6 py-4 bg-slate-50/60 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
								<FormattedDate date={post.data.pubDate} />
								<a href={`/blog/${post.id}/`} class="font-bold text-blue-600 hover:text-blue-800">
									Ler →
								</a>
							</div>
						</article>
					))}
				</div>
			</section>

			<!-- Adsterra Anúncio 2: Rodapé Responsivo (728x90 no Desktop / 320x50 no Mobile) -->
			<AdsterraResponsiveBanner desktopSize="728x90" mobileSize="320x50" />
		</main>

		<Footer />

		<script>
			const buttons = document.querySelectorAll<HTMLElement>('.category-btn');
			const cards = document.querySelectorAll<HTMLElement>('.blog-card');
			const featuredSection = document.getElementById('featured-post-section');
			const heading = document.getElementById('posts-grid-heading');

			function applyFilter(categoryName: string) {
				buttons.forEach((btn) => {
					const isMatch = btn.dataset.categoryFilter === categoryName;
					btn.classList.toggle('bg-blue-600', isMatch);
					btn.classList.toggle('text-white', isMatch);
					btn.classList.toggle('border-blue-600', isMatch);
					btn.classList.toggle('font-semibold', isMatch);
					btn.classList.toggle('bg-white', !isMatch);
					btn.classList.toggle('text-slate-700', !isMatch);
					btn.classList.toggle('border-slate-200', !isMatch);
				});

				if (featuredSection) {
					const featCat = featuredSection.dataset.postCategory || '';
					featuredSection.style.display =
						categoryName === 'all' || featCat === categoryName ? '' : 'none';
				}

				cards.forEach((card) => {
					const cardCat = card.dataset.postCategory || '';
					card.style.display =
						categoryName === 'all' || cardCat === categoryName ? '' : 'none';
				});

				if (heading) {
					heading.textContent =
						categoryName === 'all'
							? 'Todos os Artigos Recentes'
							: `Artigos sobre ${categoryName}`;
				}
			}

			buttons.forEach((btn) => {
				btn.addEventListener('click', (e) => {
					const filter = btn.dataset.categoryFilter || 'all';
					if (filter === 'all') {
						e.preventDefault();
						history.replaceState(null, '', window.location.pathname);
					}
					applyFilter(filter);
				});
			});

			function checkHash() {
				const hash = window.location.hash.replace('#', '');
				if (!hash) return;
				const matchBtn = document.querySelector<HTMLElement>(
					`.category-btn[data-category-slug="${hash}"]`,
				);
				if (matchBtn && matchBtn.dataset.categoryFilter) {
					applyFilter(matchBtn.dataset.categoryFilter);
				}
			}

			window.addEventListener('hashchange', checkHash);
			checkHash();
		</script>
	</body>
</html>

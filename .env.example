# Google AdSense - Vida de Pai
# Quando sua conta for aprovada no Google AdSense, configure aqui ou nas variáveis de ambiente do Cloudflare Pages:
PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Web3Forms - Chave para receber mensagens do formulário de contato no seu e-mail
# Obtenha em https://web3forms.com informando seu e-mail (grátis):
PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

